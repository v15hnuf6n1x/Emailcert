# Certificate Generation Module - Environment Configuration
# Copy this file to .env.local and customize values
# Loaded via TemplateConfig.from_env() and logger setup

# --- Template & Output Settings ---
# Template can be any PNG: absolute path or relative like emailcert/certgen/src/cert-img.png (2000x1414)
CERT_TEMPLATE_PATH=emailcert/certgen/src/cert-img.png
CERT_TEMPLATE_FORMAT=png              # png or svg
CERT_QUALITY=95                       # PNG quality 1-100

# Output - for production PDFs and PNGs are stored in separate subdirectories as requested
CERT_OUTPUT_DIR=certificates          # base dir
CERT_OUTPUT_PDF_DIR=certificates/pdf  # PDFs for email sending
CERT_OUTPUT_PNG_DIR=certificates/png  # PNGs for preview
# For testing you can use: CERT_OUTPUT_DIR=draft_test

# --- Template Positioning (pixels from top-left) - for src/cert-img.png (2000x1414) ---
# Center X = 1000 (2000/2). Dash lines detected at y=860 (name) and y=946 (team)
# Text is 28/25px above dash: name 832, team 921. Adjust if text not on dash after sample.
CERT_NAME_POS_X=1000
CERT_NAME_POS_Y=832
CERT_TEAM_POS_X=1000
CERT_TEAM_POS_Y=921
CERT_DEPT_POS_X=1000
CERT_DEPT_POS_Y=1050
CERT_YEAR_POS_X=1000
CERT_YEAR_POS_Y=1120
CERT_CENTER_TEXT=true                 # true/false - center text at position (anchor mm)

# --- Font Settings ---
# PERFECT CERTIFICATE USED: DancingScript cursive as you requested (added emailcert/certgen/fonts/DancingScript-Regular.ttf)
# This is exactly what generated draft_test/Kavin_Dancing.pdf + test.pdf without black noise
CERT_FONT_PATH=emailcert/certgen/fonts/DancingScript-Regular.ttf
CERT_FONT_SIZE_NAME=56
CERT_FONT_SIZE_TEAM=48
CERT_DEPT_FONT_SIZE=36
CERT_YEAR_FONT_SIZE=32

# --- Text Appearance (RGB) ---
CERT_TEXT_COLOR_R=0
CERT_TEXT_COLOR_G=0
CERT_TEXT_COLOR_B=0

# --- SVG Template Settings (when CERT_TEMPLATE_FORMAT=svg) ---
CERT_SVG_NAME_ELEMENT_ID=name         # id of <text> element to replace with participant name
CERT_SVG_TEAM_ELEMENT_ID=team         # id of <text> element to replace with team name
CERT_SVG_DEPT_ELEMENT_ID=department   # id for department (injected if missing)
CERT_SVG_YEAR_ELEMENT_ID=year         # id for year (injected if missing)

# --- Logging ---
CERT_LOG_LEVEL=INFO                   # DEBUG, INFO, WARNING, ERROR

# --- Fallback Font Paths (comma-separated, used if CERT_FONT_PATH not found) ---
# Linux defaults already coded: /usr/share/fonts/truetype/liberation/LiberationSans-Regular.ttf:/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
# Windows: C:\Windows\Fonts\arial.ttf
# macOS: /Library/Fonts/Arial.ttf
CERT_FALLBACK_FONT_PATHS=/usr/share/fonts/truetype/liberation/LiberationSans-Regular.ttf:/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf

# --- Spreadsheet Column Mapping (for wide-format sheets like sparkverse) ---
# For future: set these to match your sheet's header row without code change
# Example for sparkverse registrations (75 teams, 278 participants):
#   Team column: Team Name
#   Name columns: Leader Name,M1 Name,M2 Name,M3 Name (one cert per name, same team)
CERT_COL_TEAM=Team Name
CERT_COL_NAMES=Leader Name,M1 Name,M2 Name,M3 Name
# For simple CSV with one participant per row (name,team) you can also use:
# CERT_COL_NAME=Full Name
# CERT_COL_TEAM=Team Name
# Or generic mapping via code: load_with_mapping(path, {"name": "Full Name", "team": "Team Name"})

# --- Optional: Campaign / Event ---
# Used for template fallback: events/{campaign}/template.png
# CERT_CAMPAIGN=sparkverse
